@model Library.Web.Models.BookPricePredictVm
@{
    ViewData["Title"] = "Predict Book Price (ML)";
}

<h1>Predict Book Price (ML)</h1>

<form asp-action="PredictBookPrice" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="AuthorId" class="form-label"></label>
        <select asp-for="AuthorId" class="form-select" asp-items="Model.Authors"></select>
    </div>

    <div class="col-md-3">
        <label asp-for="GenreId" class="form-label"></label>
        <select asp-for="GenreId" class="form-select" asp-items="Model.Genres"></select>
    </div>

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Predict</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

@if (Model.PredictedPrice.HasValue)
{
    <div class="alert alert-success mt-3">
        Predicted price: <b>@Model.PredictedPrice.Value.ToString("0.00")</b>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}